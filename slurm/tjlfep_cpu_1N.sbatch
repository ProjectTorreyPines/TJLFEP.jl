#!/bin/bash -l
# =============================================================================
# TJLFEP on CPU, LOW FOOTPRINT: all SCAN_N radii on ONE CPU node.
#
#   The master spawns 2 Julia workers (SlurmClusterManager, 64 threads each) and pmaps the
#   radii over them; pmap hands a worker the next radius as soon as it is free, so any
#   SCAN_N works and straggler radii do not idle the node. Smallest possible footprint,
#   easy to backfill in the queue, but SLOW: roughly 10x the 10-node wall. Measured
#   10-node grid wall x10 (DIII-D case): nb6 ~20 min, nb8 ~30 min, nb16 ~2 h, nb32 ~15 h.
#   Use N_BASIS <= 16 here, or SOLVER=ad; use the GPU templates for production.
#
# Usage (from the repo root, so the job can find this checkout):
#   cd TJLFEP
#   edit the CONFIG block below (at least: #SBATCH -A, TGLFEP_FILE)
#   sbatch slurm/tjlfep_cpu_1N.sbatch
# =============================================================================
#SBATCH -A m3739                   # EDIT: your NERSC CPU allocation (no _g suffix)
#SBATCH -q regular
#SBATCH -C cpu
#SBATCH -N 1
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=64
#SBATCH -t 06:00:00
#SBATCH -J tjlfep_cpu_1N
#SBATCH -o tjlfep_cpu_1N_%j.out
#SBATCH -e tjlfep_cpu_1N_%j.err

set -uo pipefail

# -----------------------------------------------------------------------------
# CONFIG -- everything a user edits is in this block. Each is VAR="${VAR:-default}" so an
# environment variable at submit time overrides the value written here (SYSIMAGE uses
# "${SYSIMAGE-...}", so `SYSIMAGE="" sbatch ...` forces JIT).
# -----------------------------------------------------------------------------
# ---- Paths ----
TJLFEP_ROOT="${TJLFEP_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"         # this checkout; auto when submitted from the repo root
CFS_DIR="${CFS_DIR:-/global/cfs/cdirs/m3739/TJLFEP}"             # shared m3739 tree: prebuilt sysimages, env_lean/env_full, depot
TJLFEP_DEPOT="${TJLFEP_DEPOT:-}"                                 # extra read-only depot; "" -> $CFS_DIR/depot (sysimage JLL artifacts)

# ---- Case / inputs ----
CASE_DIR="${CASE_DIR:-${TJLFEP_ROOT}/examples/DIIID_202017C42_500ms_v3.1}"   # directory holding input.gacode
GACODE_FILE="${GACODE_FILE:-${CASE_DIR}/input.gacode}"                      # equilibrium + profiles (EXPRO format)
TGLFEP_FILE="${TGLFEP_FILE:-${CASE_DIR}/input_scan20_nb16.TGLFEP}"          # scan control. PHYSICS KNOBS LIVE HERE:
                                                                            #   SCAN_N, N_BASIS, IRS, WIDTH_MIN/WIDTH_MAX,
                                                                            #   FACTOR_IN, PROCESS_IN, KY_MODEL, ... (see slurm/README.md)
OUT_DIR="${OUT_DIR:-${TJLFEP_ROOT}/runs/cpu_1N_${SLURM_JOB_ID:-local}}"      # out.TGLFEP, sfmin_scan.txt, alpha_*_crit.input

# ---- Solver ----
SOLVER="${SOLVER:-grid}"                 # grid      Fortran-equivalent (kyhat x width x factor) sweep, w>=1 box     [verified vs Fortran]
                                         # ad        autodiff onset root-find; see AD_EXTEND_MODE                      [grid-independent]
                                         # robust_ad w>=1 grid-zoom + extended narrow-width locate                     [reference tier]
                                         # truth     robust_ad + N_BASIS ladder at the optimum                          [reference tier, slow]
AD_EXTEND_MODE="${AD_EXTEND_MODE:-locate}"   # SOLVER=ad only: only | wide | locate (see the GPU templates / slurm/README.md)
AD_WIDE_KDESC="${AD_WIDE_KDESC:-2}"          # ad :wide multistart breadth
AD_FAITHFUL_CONFIRM="${AD_FAITHFUL_CONFIRM:-1}"   # ad: 0 skips the faithful IFLUX confirm
REFINE_ROUNDS="${REFINE_ROUNDS:-1}"          # robust_ad / truth: (ky,w) window-narrowing rounds
TJLFEP_K_MAX="${TJLFEP_K_MAX:-4}"            # grid: scale-factor refinement rounds
TJLFEP_NMODES="${TJLFEP_NMODES:-4}"          # eigenmodes kept per ky
TJLFEP_NXGRID="${TJLFEP_NXGRID:-}"           # "" -> max(N_BASIS, 32) Hermite quadrature points (debug knob)
TJLFEP_DEBUG="${TJLFEP_DEBUG:-0}"            # 1 prints matched [*_DBG] lines (Fortran comparison)

# ---- Parallel layout ----
JULIA_WORKER_THREADS="${JULIA_WORKER_THREADS:-${SLURM_CPUS_PER_TASK:-64}}"   # threads per worker (the ky loop is threaded)
TJLFEP_INSTANTIATE="${TJLFEP_INSTANTIATE:-0}"   # 1 = Pkg.instantiate()+precompile() in the job first (JIT from a fresh checkout only;
                                                #     never against the read-only CFS env)

# ---- Sysimage ----
SYSIMAGE="${SYSIMAGE-${TJLFEP_SYSIMAGE:-${CFS_DIR}/TJLFEP_cpu_sysimage.so}}"   # prebuilt CPU image (m3739 members).
                                             #   ""  -> JIT from this checkout (slower startup on every worker)
                                             #   build/TJLFEP_cpu_sysimage.so -> your own bake (see build/README.md)
PROJECT="${PROJECT:-}"                       # julia --project. "" = auto: <sysimage dir>/env_lean with a sysimage, else $TJLFEP_ROOT
# -----------------------------------------------------------------------------
# End of CONFIG. Nothing below needs editing.
# -----------------------------------------------------------------------------

DEVICE=cpu
EXPECT_NTASKS_EQ_SCAN_N=0
source "${TJLFEP_ROOT}/slurm/common/tjlfep_env.inc.sh" \
    || { echo "ERROR: cannot source ${TJLFEP_ROOT}/slurm/common/tjlfep_env.inc.sh -- submit from the repo root or export TJLFEP_ROOT" >&2; exit 1; }
tjlfep_setup

cd "${TJLFEP_ROOT}"
t_start=$(date +%s)
# The master runs here; it spawns one worker per Slurm task via srun (SlurmClusterManager)
# and pmaps the SCAN_N radii over the 2 workers.
stdbuf -oL -eL "${JULIA[@]}" -t 8 "${TJLFEP_ROOT}/slurm/common/run_scan_cpu_distributed.jl"
echo "=== done in $(( $(date +%s) - t_start )) s; out.TGLFEP + sfmin_scan.txt + alpha_*_crit.input in ${OUT_DIR} ==="
