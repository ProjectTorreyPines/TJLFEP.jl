# Apptainer counterpart of Containerfile.gpu: layer the GPU-traced sysimage
# onto the published TJLFEP SIF for local (e.g. Defiant) use. Build from the
# directory holding sys_tjlfep_gpu.so:
#
#   apptainer build --build-arg BASE_SIF=$WORK/tjlfep_v2.0.14.sif \
#       tjlfep_v2.0.14-gpu.sif /path/to/gpu-sysimage/tjlfep_gpu.def
#
# The tjlfep launcher picks the sysimage up automatically at this path.
# The PUBLISHED :<v>-gpu OCI tag is produced separately (crane append or
# Containerfile.gpu) so podman/docker sites get the identical layer.

Bootstrap: localimage
From: {{ BASE_SIF }}

%arguments
    BASE_SIF=tjlfep.sif

%files
    sys_tjlfep_gpu.so /opt/tjlfep/sys_tjlfep_gpu.so
