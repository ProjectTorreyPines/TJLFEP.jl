# Layer a GPU-traced sysimage onto a published TJLFEP image. Build context is
# the bake output dir (holds sys_tjlfep_gpu.so); the tjlfep launcher picks the
# sysimage up automatically at this path.
#   podman-hpc build -t localhost/tjlfep:<v>-gpu -f Containerfile.gpu \
#       --build-arg BASE=ghcr.io/projecttorreypines/tjlfep:<v> $PSCRATCH/tjlfep_sysimage_out
ARG BASE
FROM ${BASE}
COPY sys_tjlfep_gpu.so /opt/tjlfep/sys_tjlfep_gpu.so
