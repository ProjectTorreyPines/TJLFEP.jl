# Parking lot for retired files (kept on disk, never shipped). Everything here is
# superseded; see git history for the tracked originals.
attic/

# Documenter build products / auto-generated API page
docs/build/
docs/site/
docs/src/api.md

# Code-coverage artifacts (julia --code-coverage=user)
*.cov
lcov.info

# Julia resolved environment: not pinned, so it always resolves fresh against
# the registry + Project.toml [compat]. Reproducibility of published results is
# guarded by [compat] bounds + the Fortran regression test.
Manifest.toml
Manifest-v*.toml
Manifest.toml.*.bak

# Slurm job stdout/stderr and run logs, wherever a job was submitted from
# (repo root for slurm/ templates, dev/ for maintainer scripts, build/ for bakes).
*.out
*.err
*.log

# Run output. slurm/ templates write to runs/; per-radius task dirs can appear
# anywhere a driver was pointed at.
runs/
**/*_tasks/

# Sysimage build products + generated build environments (published to CFS by the bake jobs)
build/*.so
build/*.so.bak
build/*.ji
build/sysimage/env_lean/
build/sysimage/env_full/

# Maintainer scripts in dev/ regenerate these (serialized matrices, scan tables,
# generated file-based inputs, per-job output dirs, plots data).
dev/**/*.jls
dev/**/*.txt
dev/**/*.so
dev/**/fileInput*/
dev/**/timing_runs/
dev/**/timing_out_*/
dev/**/fortran_runs/
dev/**/debug_out_*/
dev/**/validate_out_*/
dev/**/smoke_out_*/
dev/**/compare_nb*/
dev/**/probe_*/
dev/**/eigvec_ab_*/
dev/**/mps*_*/
dev/**/.layout_jobids
